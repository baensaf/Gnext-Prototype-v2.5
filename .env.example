# Gnext Prototype v2 — Environment Configuration Template

# Backend Server Configuration
PORT=3100
DATA_DIR=./data
SEED_PROFILE=minimal

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=admin
DB_NAME=appdb

# Shared Administrator Credentials
ADMIN_USERNAME=admin@gnext.local
ADMIN_PASSWORD=GnextDemo!2026

# Operational PIN Approval Profile
APPROVER_DEMO_PIN=2468

# Frontend Configuration (starter-vite-ts/.env)
VITE_SERVER_URL=http://localhost:3100

# Branch agent: lets CI add unpublished agent builds after each deploy of main.
# Same value as the AGENT_RELEASE_TOKEN repository secret, at least 32 characters. Empty = off.
AGENT_RELEASE_CI_TOKEN=
