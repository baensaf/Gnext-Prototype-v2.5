<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Settings Saman's SDK reads. Its logs go under the agent's data folder. -->
  <appSettings>
    <add key="LogBasePath" value="C:\ProgramData\Gnext\Agent\logs\saman" />
    <add key="LogPath" value="C:\ProgramData\Gnext\Agent\logs\saman\" />
    <add key="logPermission" value="1" />
    <add key="MinimumAmount" value="1" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
